{
  "name": "vite-ui-sandbox-worker-test",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/prepare-sites-build.mjs",
    "preview": "vite preview",
    "test:dependencies": "depcruise src --config .dependency-cruiser.mjs --output-type err-long",
    "test:unused": "knip",
    "test:smoke": "playwright test tests/e2e/smoke.spec.mjs",
    "test:accessibility": "playwright test tests/e2e/accessibility.spec.mjs",
    "test:visual": "node scripts/run-backstop.mjs test",
    "test:visual:reference": "node scripts/run-backstop.mjs reference",
    "test:sites": "node --test tests/sites-worker.test.mjs"
  },
  "dependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "@vitejs/plugin-react": "5.0.4",
    "country-list": "^2.4.1",
    "d3-geo": "^3.1.1",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "topojson-client": "^3.1.0",
    "vite": "6.4.2",
    "world-atlas": "^2.0.2",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.64.0",
    "backstopjs": "^6.3.25",
    "dependency-cruiser": "^17.4.3",
    "knip": "^6.41.0"
  }
}
